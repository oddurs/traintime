{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "services/**",
      "src/lib/**",
      "Dockerfile",
      "package.json",
      "package-lock.json",
      "public/data/network.json",
      "public/data/timing.json",
      "public/data/eta-model.json"
    ]
  },
  "deploy": {
    "startCommand": "sh -c 'cp -n /app/seed/*.json \"$TRAINTIME_DATA_DIR\"/ 2>/dev/null; exec npx tsx services/poller/index.ts'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
