{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "services/**",
      "src/lib/**",
      "Dockerfile",
      "package.json",
      "package-lock.json",
      "public/data/network.json",
      "public/data/timing.json",
      "public/data/eta-model.json",
      "Dockerfile.site",
      "src/**",
      "public/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
