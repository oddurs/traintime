{
  "name": "traintime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run -s prepare:assets",
    "dev": "concurrently -n web,poller -c blue,green \"next dev -p 7117\" \"tsx services/poller/index.ts\"",
    "dev:web": "next dev -p 7117",
    "poller": "tsx services/poller/index.ts",
    "build": "next build",
    "prebuild": "npm run -s prepare:assets",
    "build:pages": "bash scripts/build-pages.sh",
    "start": "next start -p 7117",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --skipLibCheck --moduleResolution bundler --module esnext --target es2022 .railway/railway.ts",
    "build:network": "tsx scripts/build-network.ts",
    "prepare:assets": "v=$(node -p \"require('maplibre-gl/package.json').version\") && rm -rf public/maplibre && mkdir -p public/maplibre/$v && cp node_modules/maplibre-gl/dist/maplibre-gl.mjs node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/$v/ && cp services/poller/proto/nyct-subway.proto public/data/",
    "snapshot": "cp data/timing.json data/eta-model.json public/data/",
    "rebuild-events": "tsx scripts/rebuild-events.ts",
    "learn": "tsx scripts/learn-timing.ts",
    "train-model": ".venv/bin/python scripts/train_eta_model.py",
    "evaluate": "tsx scripts/evaluate.ts",
    "publish-accuracy": "tsx scripts/publish-accuracy.ts",
    "test": "tsx --test tests/*.test.ts",
    "audit": "tsx scripts/audit.ts",
    "audit:replay": "tsx scripts/audit-replay.ts",
    "audit:design": "tsx scripts/audit-design.ts",
    "evaluate:day": "tsx scripts/evaluate-windows.ts",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:weight": "node scripts/audit-weight.mjs --serve",
    "build:site": "NEXT_PUBLIC_BASE_PATH= bash scripts/build-pages.sh",
    "site": "tsx services/site/index.ts",
    "audit:layout": "tsx scripts/audit-layout.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "audit:frames": "node scripts/audit-frames.mjs",
    "audit:ring": "node scripts/audit-ring.mjs",
    "audit:fan": "tsx scripts/audit-fan.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "adm-zip": "^0.6.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.7.0",
    "protobufjs": "^8.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "next": "^16.3.4",
    "railway": "^3.11.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "Live, physically simulated map of every New York City subway train, learned from the MTA realtime feeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddurs/traintime.git"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ]
}
